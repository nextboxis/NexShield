# ═══════════════════════════════════════════════════════════════
#  NexShield — Production Environment Configuration
# ═══════════════════════════════════════════════════════════════
#
#  Copy this file to .env and customize values for your environment
#  NEVER commit .env to version control
#

# ── Flask Configuration ──────────────────────────────────────────
FLASK_ENV=production
FLASK_DEBUG=false
FLASK_SECRET_KEY=your-super-secret-key-here-change-this-in-production

# ── Security: Admin User ─────────────────────────────────────────
# Change this immediately in production!
ADMIN_PASSWORD=change-me-immediately-in-production

# ── Database Configuration ───────────────────────────────────────
MONGO_URI=mongodb://username:password@mongodb-host:27017/
MONGO_DB=threat_intel

# ── Server Configuration ─────────────────────────────────────────
PORT=5000
# Server binding: 127.0.0.1 = localhost only (RECOMMENDED for local use)
# Change to 0.0.0.0 if you need network access (not recommended without proxy)
SERVER_HOST=127.0.0.1

# ── CORS & Security ──────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ── Metasploit RPC ──────────────────────────────────────────────
# Leave blank to disable Metasploit integration
MSF_RPC_HOST=127.0.0.1
MSF_RPC_PORT=55553
MSF_RPC_USER=msf
MSF_RPC_PASS=

# ── Logging ──────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=nexshield.log
