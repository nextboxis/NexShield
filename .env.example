# ═══════════════════════════════════════════════════════════════
#  NexShield — Environment Configuration
# ═══════════════════════════════════════════════════════════════
#  Copy this file to .env and edit the values below.
#  On first run, NexShield will auto-create .env if missing.
# ═══════════════════════════════════════════════════════════════

# ── Flask Settings ────────────────────────────────────────────
FLASK_SECRET_KEY=change-me-to-a-random-string
FLASK_ENV=development
FLASK_DEBUG=true
PORT=5000

# ── Database ──────────────────────────────────────────────────
# Default: TinyDB (built-in, zero-install, file-based)
# To use MongoDB instead, uncomment the lines below:
# MONGO_URI=mongodb://localhost:27017/
# MONGO_DB=threat_intel

# ── Admin Account (auto-created on first run) ─────────────────
ADMIN_USERNAME=Admin
ADMIN_PASSWORD=ADMIN

# ── Optional: Nmap path (usually auto-detected from PATH) ────
# NMAP_PATH=/usr/bin/nmap

# ── Optional: Metasploit RPC (for exploit execution) ─────────
# MSF_PASSWORD=nexshield
# MSF_HOST=127.0.0.1
# MSF_PORT=55553

# ── Optional: Allowed Origins (for CORS) ─────────────────────
# ALLOWED_ORIGINS=http://127.0.0.1:5000,http://localhost:5000
